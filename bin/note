#!/usr/bin/env python3
"""Render a note from a template in my-templates/ and archive the source.

Articles are saved as readable markdown, YouTube links as a flattened
transcript, both under sources/. Summary text is read from stdin, so it never
has to survive shell quoting:

    bin/note https://example.com/post --slug author-short-title \
        --tags agent-from-scratch --set topic="agent design" <<'EOF'
    Two or three sentences.
    EOF
"""

import argparse
import re
import subprocess
import sys
import tempfile
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from vaultlib import identity  # noqa: E402

VAULT = Path(__file__).resolve().parent.parent
TODAY = date.today().isoformat()
IS_VIDEO = re.compile(r"youtube\.com|youtu\.be")
FOLDERS = {"reading": "reading", "who": "who"}
# templates whose body is someone's take, and so gets a heading per author.
# A who note is shared reference — nobody owns a paragraph of it.
AUTHORED = {"reading", "synthesis"}

# Source kinds, matched in order; anything unrecognised is a plain blog post.
# "book" has no URL signature, so it has to be passed explicitly.
KINDS = [
    # host-anchored so docs.github.com stays docs
    ("repo", r"^https?://(?:www\.|gist\.)?(?:github|gitlab)\.com/"
             r"|^https?://(?:codeberg|bitbucket)\.org/"),
    ("video", r"youtube\.com|youtu\.be|vimeo\.com"),
    ("paper", r"arxiv\.org|biorxiv\.org|doi\.org|\.pdf(?:$|\?)"),
    ("course", r"/academy(?:/|$)|/courses?(?:/|$)|\.academy/"),
    ("docs", r"docs\.|/docs(?:/|$)|developer\.|/reference/"),
]


def infer_kind(url):
    for kind, pat in KINDS:
        if re.search(pat, url, re.I):
            return kind
    return "post"


def set_field(body, key, value):
    """Set a frontmatter key, adding it to the block if it isn't there yet.

    A value starting with a newline is a YAML list, so the colon gets no space.
    Replacements go through lambdas because a value containing a backslash would
    otherwise be read as a regex escape."""
    line = f"{key}:{value}" if value.startswith("\n") else f"{key}: {value}"
    pat = rf"^{re.escape(key)}:(?:.*(?:\n  - .*)*)$"
    if re.search(pat, body, re.M):
        return re.sub(pat, lambda m: line, body, count=1, flags=re.M)
    return re.sub(r"(?s)^(---\n.*?)(---\n)", lambda m: m[1] + line + "\n" + m[2],
                  body, count=1)


def flatten_vtt(raw, every=90):
    """YouTube auto-captions repeat each line across cues; keep one copy and
    group the result into timestamped paragraphs."""
    recent, out, cur, start = [], [], [], None
    for block in raw.split("\n\n"):
        m = re.search(r"^(\d\d):(\d\d):(\d\d)\.\d+ -->", block, re.M)
        if not m:
            continue
        t = int(m[1]) * 3600 + int(m[2]) * 60 + int(m[3])
        for line in block.split("\n")[1:]:
            line = re.sub(r"<[^>]+>", "", line).strip()
            if not line or line in recent:
                continue
            recent.append(line)
            del recent[:-6]
            start = t if start is None else start
            cur.append(line)
        if start is not None and t - start >= every:
            out.append(f"**[{start // 60:02d}:{start % 60:02d}]** " + " ".join(cur))
            cur, start = [], None
    if cur:
        out.append(f"**[{start // 60:02d}:{start % 60:02d}]** " + " ".join(cur))
    return "\n\n".join(out)


def fetch(url):
    """Return the source as markdown, or None if it can't be retrieved."""
    if IS_VIDEO.search(url):
        with tempfile.TemporaryDirectory() as tmp:
            res = subprocess.run(
                ["uvx", "--quiet", "yt-dlp", "--write-auto-subs", "--write-subs",
                 "--sub-lang", "en.*", "--skip-download", "--sub-format", "vtt",
                 "-o", f"{tmp}/v.%(ext)s", url],
                capture_output=True, text=True)
            vtts = sorted(Path(tmp).glob("*.vtt"))
            if vtts:
                return flatten_vtt(vtts[0].read_text(encoding="utf-8"))
    else:
        res = subprocess.run(
            ["uvx", "--quiet", "trafilatura", "-u", url, "--markdown", "--no-comments"],
            capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    print(f"could not archive {url}: {res.stderr.strip()[:200]}", file=sys.stderr)
    return None


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("url", nargs="?", default="", help="omit for sources with no URL")
    ap.add_argument("--slug", required=True, help="filename and H1, no .md")
    ap.add_argument("--kind", choices=[k for k, _ in KINDS] + ["post", "book"],
                    help="default: inferred from the URL")
    ap.add_argument("--template", default="reading",
                    help="template in my-templates/, without .md (default: reading)")
    ap.add_argument("--tags", default="", help="comma-separated, appended and deduped")
    ap.add_argument("--added-by", default="",
                    help="who's adding the note (default: git user.name, else whoami)")
    ap.add_argument("--by", default="",
                    help="who made the source; comma-separated, links into who/")
    ap.add_argument("--harness", default="",
                    help="which system the note is about, e.g. deepagents or pi,claude-code")
    ap.add_argument("--set", default=[], action="append", metavar="KEY=VALUE",
                    help="set any frontmatter key, e.g. --set topic='agent design'")
    ap.add_argument("--no-archive", action="store_true", help="skip the sources/ copy")
    ap.add_argument("--force", action="store_true", help="overwrite an existing note")
    args = ap.parse_args()

    # the template decides where the note lands; anything unlisted is the
    # user's own writing and belongs at the vault root
    is_reading = args.template == "reading"
    kind = args.kind or infer_kind(args.url)
    tpl = VAULT / "my-templates" / f"{args.template}.md"
    dest = VAULT / FOLDERS.get(args.template, "") / f"{args.slug}.md"
    copy = VAULT / "sources" / f"{args.slug}.md"
    if not tpl.exists():
        sys.exit(f"no template at {tpl}")
    if dest.exists() and not args.force:
        sys.exit(f"{dest.name} exists (use --force)")

    # re-running on an existing note edits it in place; the template is only
    # the starting point for a brand new one
    is_new = not dest.exists()
    body = (tpl if is_new else dest).read_text(encoding="utf-8")
    body = body.replace("{{title}}", args.slug).replace('"{{date}}"', TODAY)
    body = body.replace("{{date}}", TODAY)

    if is_reading and args.url and not args.no_archive and (text := fetch(args.url)):
        copy.parent.mkdir(exist_ok=True)
        dest.parent.mkdir(exist_ok=True)
        origin = ("youtube auto-captions, expect transcription errors"
                  if IS_VIDEO.search(args.url) else "article text")
        copy.write_text(
            f"---\nsourceUrl: {args.url}\nfetched: {TODAY}\nsource: {origin}\n---\n\n{text}\n",
            encoding="utf-8")
        print(copy)

    fields = dict(p.split("=", 1) for p in args.set)
    # a re-run keeps the kind already on the note unless one is passed, so an
    # explicit --kind at creation isn't overwritten by a URL guess
    if is_reading and (is_new or args.kind):
        fields["kind"] = kind
    # don't reattribute a note someone else already added
    author = args.added_by or identity()
    if args.added_by or not re.search(r"(?m)^addedBy: *\S", body):
        fields["addedBy"] = author
    if args.harness:
        names = [h.strip() for h in args.harness.split(",") if h.strip()]
        fields["harness"] = "".join(f"\n  - {h}" for h in names)
    if args.by:
        # wikilinks so the property is clickable and shows in the graph
        names = [b.strip() for b in args.by.split(",") if b.strip()]
        fields["by"] = "".join(f'\n  - "[[{b}]]"' for b in names)
    if args.url:
        fields["sourceUrl"] = args.url
    if copy.exists():
        fields["localCopy"] = f'"[[sources/{args.slug}|archived copy]]"'
    for key, value in fields.items():
        body = set_field(body, key, value)

    # scoped to the tags: block, since harness: is also a list of "  - " lines
    block = re.search(r"(?m)^tags:((?:\n  - .*)*)", body)
    present = re.findall(r"- (.+)", block[1]) if block else []
    fresh = [t for t in (t.strip() for t in args.tags.split(",")) if t and t not in present]
    if fresh and block:
        added = "".join(f"\n  - {t}" for t in fresh)
        body = body[:block.end()] + added + body[block.end():]

    summary = "" if sys.stdin.isatty() else sys.stdin.read().strip()
    if summary:
        quoted = "\n".join(f"> {ln}" if ln.strip() else ">" for ln in summary.split("\n"))
        block = f"> [!claude] Claude summary\n{quoted}"
        body = re.sub(r"(?m)^(?:> \[!claude\].*\n)?(?:Claude summary:\n\n)?(?:>.*\n)+\n*",
                      "", body)
        body = re.sub(rf"^(# {re.escape(args.slug)}\n)\n*",
                      lambda m: f"{m.group(1)}\n{block}\n\n", body, count=1, flags=re.M)

    # a heading per author, so two people can write without editing the same
    # lines; only seeded on creation, never touched on a re-run
    if is_new and args.template in AUTHORED:
        body = re.sub(r"(?m)^(## [^\n]*\n)",
                      lambda m: f"{m[1]}\n### {author}\n", body, count=1)

    dest.parent.mkdir(exist_ok=True)
    dest.write_text(body, encoding="utf-8")
    print(dest)


if __name__ == "__main__":
    main()
